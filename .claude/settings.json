{
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "env": {
    "WORKSPACE": "/Users/saggesel/Projects/frontaliere",
    "SKIP_FUEL_DAILY": "1",
    "SKIP_WEEKLY_EMPLOYERS": "1",
    "SKIP_JOB_MARKET_SNAPSHOT": "1",
    "SKIP_HEALTH_PREMIUMS": "1",
    "SKIP_ORPHAN_LANDINGS": "1",
    "SKIP_BORDER_WAIT": "1",
    "SKIP_CI_CHECK": "1",
    "FAST_BUILD": "1",
    "NODE_OPTIONS": "--max-old-space-size=12288",
    "GOOGLE_APPLICATION_CREDENTIALS": "/Users/saggesel/.config/frontaliere/sa-frontaliere-ticino.json",
    "FRONTALIERE_GH_COORDINATOR": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'find_policy() { d=\"$1\"; [ -n \"$d\" ] || return 1; d=\"$(CDPATH= cd -- \"$d\" 2>/dev/null && pwd -P)\" || return 1; while :; do [ -f \"$d/bin/github-api-policy.mjs\" ] && { printf \"%s/bin/github-api-policy.mjs\\n\" \"$d\"; return 0; }; parent=\"$(dirname \"$d\")\"; [ \"$parent\" = \"$d\" ] && return 1; d=\"$parent\"; done; }; p=\"$(find_policy \"$PWD\" || find_policy \"${WORKSPACE:-}\" || find_policy \"${CODEX_PROJECT_DIR:-}\" || find_policy \"${CLAUDE_PROJECT_DIR:-}\")\" || exit 0; node \"$p\"'"
          },
          {
            "type": "command",
            "command": "sh -c 'd=\"${CLAUDE_PROJECT_DIR:-${WORKSPACE:-$PWD}}\"; [ -f \"$d/scripts/ci/run-mutation-gate.mjs\" ] || d=\"$d/frontaliere-si-o-no\"; [ -f \"$d/scripts/ci/run-mutation-gate.mjs\" ] || d=\"${WORKSPACE:-$d}/frontaliere-si-o-no\"; [ -f \"$d/scripts/ci/run-mutation-gate.mjs\" ] || exit 0; node \"$d/scripts/ci/run-mutation-gate.mjs\"'"
          },
          {
            "type": "command",
            "command": "sh -c 'd=\"${CLAUDE_PROJECT_DIR:-${WORKSPACE:-$PWD}}\"; [ -f \"$d/scripts/ci/pr-body-write-gate.mjs\" ] || d=\"$d/frontaliere-si-o-no\"; [ -f \"$d/scripts/ci/pr-body-write-gate.mjs\" ] || d=\"${WORKSPACE:-$d}/frontaliere-si-o-no\"; [ -f \"$d/scripts/ci/pr-body-write-gate.mjs\" ] || exit 0; node \"$d/scripts/ci/pr-body-write-gate.mjs\"'"
          },
          {
            "type": "command",
            "command": "sh -c 'd=\"${WORKSPACE:-${CLAUDE_PROJECT_DIR:-$PWD}}\"; [ -f \"$d/.codex/repo-pr-gate-dispatch.mjs\" ] || exit 0; node \"$d/.codex/repo-pr-gate-dispatch.mjs\"'"
          },
          {
            "type": "command",
            "command": "sh -c 'd=\"$CLAUDE_PROJECT_DIR\"; [ -f \"$d/scripts/ci/pr-body-check-gate.mjs\" ] || d=\"$d/frontaliere-si-o-no\"; [ -f \"$d/scripts/ci/pr-body-check-gate.mjs\" ] || d=\"$WORKSPACE/frontaliere-si-o-no\"; node \"$d/scripts/ci/pr-body-check-gate.mjs\"'"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'd=\"${CLAUDE_PROJECT_DIR:-${CODEX_PROJECT_DIR:-${WORKSPACE:-$PWD}}}\"; [ -f \"$d/bin/where-to-fix-hook.mjs\" ] || d=\"${WORKSPACE:-$d}\"; [ -f \"$d/bin/where-to-fix-hook.mjs\" ] || d=\"$(cd \"$d/..\" && pwd)\"; node \"$d/bin/where-to-fix-hook.mjs\" || true'",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'd=\"${CLAUDE_PROJECT_DIR:-${WORKSPACE:-$PWD}}\"; [ -x \"$d/bin/gh-frontaliere\" ] || d=\"$WORKSPACE/bin/gh-frontaliere\"; [ -x \"$d\" ] || exit 0; node \"$d\" ping >/dev/null 2>&1 || true'"
          },
          {
            "type": "command",
            "command": "sh -c 'd=\"$CLAUDE_PROJECT_DIR\"; [ -f \"$d/scripts/prune-merged-worktrees.mjs\" ] || d=\"$d/frontaliere-si-o-no\"; [ -f \"$d/scripts/prune-merged-worktrees.mjs\" ] || d=\"$WORKSPACE/frontaliere-si-o-no\"; ( cd \"$d\" && node scripts/prune-merged-worktrees.mjs --apply >/dev/null 2>&1; node scripts/sync-main-checkout.mjs >/dev/null 2>&1 & ) || true'"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'd=\"$CLAUDE_PROJECT_DIR\"; [ -f \"$d/scripts/prune-merged-worktrees.mjs\" ] || d=\"$d/frontaliere-si-o-no\"; [ -f \"$d/scripts/prune-merged-worktrees.mjs\" ] || d=\"$WORKSPACE/frontaliere-si-o-no\"; cd \"$d\" && node scripts/prune-merged-worktrees.mjs --apply --orphans-only 2>/dev/null || true'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'd=\"$CLAUDE_PROJECT_DIR\"; [ -f \"$d/scripts/ci/pr-watch-register.mjs\" ] || d=\"$d/frontaliere-si-o-no\"; [ -f \"$d/scripts/ci/pr-watch-register.mjs\" ] || d=\"$WORKSPACE/frontaliere-si-o-no\"; node \"$d/scripts/ci/pr-watch-register.mjs\"'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'd=\"$CLAUDE_PROJECT_DIR\"; [ -f \"$d/scripts/ci/pr-watch-gate.mjs\" ] || d=\"$d/frontaliere-si-o-no\"; [ -f \"$d/scripts/ci/pr-watch-gate.mjs\" ] || d=\"$WORKSPACE/frontaliere-si-o-no\"; node \"$d/scripts/ci/pr-watch-gate.mjs\"'",
            "timeout": 930
          }
        ]
      }
    ]
  }
}
