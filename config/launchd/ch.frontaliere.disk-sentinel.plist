<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ch.frontaliere.disk-sentinel</string>
	<key>ProgramArguments</key>
	<array>
		<string>@@NODE_BIN@@</string>
		<string>@@WORKSPACE@@/bin/disk-sentinel.mjs</string>
	</array>
	<key>StartInterval</key>
	<integer>900</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>Nice</key>
	<integer>10</integer>
	<key>WorkingDirectory</key>
	<string>@@WORKSPACE@@</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key><string>@@HOME@@</string>
		<key>PATH</key><string>@@PATH@@</string>
		<key>WORKSPACE</key><string>@@WORKSPACE@@</string>
	</dict>
	<key>StandardOutPath</key>
	<string>@@LOG_DIR@@/disk-sentinel.launchd.out.log</string>
	<key>StandardErrorPath</key>
	<string>@@LOG_DIR@@/disk-sentinel.launchd.err.log</string>
</dict>
</plist>
