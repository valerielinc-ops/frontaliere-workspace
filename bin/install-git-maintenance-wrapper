#!/bin/sh

# Installs the wrapper outside the repository so launchd can use it while the
# shared workspace checkout remains dirty. Existing custom plists are backed
# up before their executable path is changed.

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 70
workspace_root=$(CDPATH= cd -- "$script_dir/.." && pwd) || exit 70
site_repo=${FRONTALIERE_SITE_REPO:-$workspace_root/frontaliere-si-o-no}
action=${1:-install}
launch_agents=${HOME:?HOME is required}/Library/LaunchAgents
install_dir="$HOME/Library/Application Support/frontaliere/git-maintenance"
backup_dir="$install_dir/original-launch-agents"
wrapper="$install_dir/git-maintenance-wrapper"
disabled_marker="$install_dir/disabled"
uid=$(/usr/bin/id -u)
plutil_bin=${FRONTALIERE_PLUTIL_BIN:-/usr/bin/plutil}
launchctl_bin=${FRONTALIERE_LAUNCHCTL_BIN:-/bin/launchctl}

set_plist_string() {
  if ! "$plutil_bin" -replace "$1" -string "$2" "$3" 2>/dev/null; then
    "$plutil_bin" -insert "$1" -string "$2" "$3"
  fi
}

case "$action" in
  install)
    [ -d "$site_repo/.git" ] || {
      printf '%s missing site repository: %s\n' "install-git-maintenance-wrapper:" "$site_repo" >&2
      exit 78
    }
    site_repo=$(CDPATH= cd -- "$site_repo" && pwd -P)
    [ -f "$script_dir/git-maintenance-wrapper" ] || {
      printf '%s missing source wrapper\n' "install-git-maintenance-wrapper:" >&2
      exit 78
    }
    /bin/rm -f "$disabled_marker"
    found=0
    for schedule in hourly daily weekly sunday; do
      [ -f "$launch_agents/ch.frontaliere.git-maintenance-$schedule.plist" ] || continue
      found=1
    done
    [ "$found" -eq 1 ] || {
      printf '%s no custom Git maintenance LaunchAgents found\n' "install-git-maintenance-wrapper:" >&2
      exit 78
    }
    git -C "$site_repo" config --local maintenance.strategy none
    git config --global --fixed-value --unset-all maintenance.repo "$site_repo" 2>/dev/null || true

    already_current=1
    /usr/bin/cmp -s "$script_dir/git-maintenance-wrapper" "$wrapper" || already_current=0
    for schedule in hourly daily weekly sunday; do
      label="ch.frontaliere.git-maintenance-$schedule"
      plist="$launch_agents/$label.plist"
      [ -f "$plist" ] || continue
      backup="$backup_dir/$label.plist"
      if [ -f "$backup" ]; then
        saved_plist=$backup
      else
        already_current=0
        saved_plist=$plist
      fi
      job_schedule=$("$plutil_bin" -extract ProgramArguments.1 raw "$saved_plist") || {
        printf '%s cannot read schedule from %s\n' "install-git-maintenance-wrapper:" "$saved_plist" >&2
        exit 78
      }
      installed_wrapper=$("$plutil_bin" -extract ProgramArguments.0 raw "$plist" 2>/dev/null) || installed_wrapper=''
      installed_schedule=$("$plutil_bin" -extract ProgramArguments.1 raw "$plist" 2>/dev/null) || installed_schedule=''
      installed_home=$("$plutil_bin" -extract EnvironmentVariables.HOME raw "$plist" 2>/dev/null) || installed_home=''
      installed_repo=$("$plutil_bin" -extract EnvironmentVariables.FRONTALIERE_SITE_REPO raw "$plist" 2>/dev/null) || installed_repo=''
      installed_stdout=$("$plutil_bin" -extract StandardOutPath raw "$plist" 2>/dev/null) || installed_stdout=''
      installed_stderr=$("$plutil_bin" -extract StandardErrorPath raw "$plist" 2>/dev/null) || installed_stderr=''
      [ "$installed_wrapper" = "$wrapper" ] \
        && [ "$installed_schedule" = "$job_schedule" ] \
        && [ "$installed_home" = "$HOME" ] \
        && [ "$installed_repo" = "$site_repo" ] \
        && [ "$installed_stdout" = "$HOME/Library/Logs/frontaliere/git-maintenance-$schedule.launchd.out.log" ] \
        && [ "$installed_stderr" = "$HOME/Library/Logs/frontaliere/git-maintenance-$schedule.launchd.err.log" ] \
        || already_current=0
    done
    if [ "$already_current" -eq 1 ]; then
      printf 'Wrapper Git gia aggiornato; LaunchAgent invariati.\n'
      exit 0
    fi

    /bin/mkdir -p "$install_dir" "$backup_dir" "$launch_agents" "$HOME/Library/Logs/frontaliere"
    temporary_wrapper="$install_dir/git-maintenance-wrapper.$$"
    /bin/cp "$script_dir/git-maintenance-wrapper" "$temporary_wrapper"
    /bin/chmod 755 "$temporary_wrapper"
    /bin/mv -f "$temporary_wrapper" "$wrapper"

    for schedule in hourly daily weekly sunday; do
      label="ch.frontaliere.git-maintenance-$schedule"
      plist="$launch_agents/$label.plist"
      [ -f "$plist" ] || continue
      backup="$backup_dir/$label.plist"
      [ -e "$backup" ] || /bin/cp "$plist" "$backup"
      job_schedule=$("$plutil_bin" -extract ProgramArguments.1 raw "$backup") || {
        printf '%s cannot read schedule from %s\n' "install-git-maintenance-wrapper:" "$backup" >&2
        exit 78
      }
      case "$job_schedule" in
        hourly|daily|weekly) ;;
        *)
          printf '%s invalid saved schedule in %s: %s\n' "install-git-maintenance-wrapper:" "$backup" "$job_schedule" >&2
          exit 78
          ;;
      esac

      temporary_plist="$plist.$$"
      # Rebuild from the saved LaunchAgent dictionary. A prior partial or
      # malformed install may have replaced the plist root with just argv.
      /bin/cp "$backup" "$temporary_plist"
      "$plutil_bin" -replace ProgramArguments -json "[\"$wrapper\",\"$job_schedule\"]" "$temporary_plist"
      set_plist_string EnvironmentVariables.HOME "$HOME" "$temporary_plist"
      set_plist_string EnvironmentVariables.FRONTALIERE_SITE_REPO "$site_repo" "$temporary_plist"
      set_plist_string StandardOutPath "$HOME/Library/Logs/frontaliere/git-maintenance-$schedule.launchd.out.log" "$temporary_plist"
      set_plist_string StandardErrorPath "$HOME/Library/Logs/frontaliere/git-maintenance-$schedule.launchd.err.log" "$temporary_plist"
      "$plutil_bin" -lint "$temporary_plist" >/dev/null
      "$launchctl_bin" bootout "gui/$uid" "$plist" >/dev/null 2>&1 || true
      /bin/mv -f "$temporary_plist" "$plist"
      "$launchctl_bin" bootstrap "gui/$uid" "$plist"
    done
    printf 'Wrapper Git con limiti installato; LaunchAgent custom ricaricati. Ripristina con: %s --restore\n' "$0"
    ;;
  --restore)
    for schedule in hourly daily weekly sunday; do
      label="ch.frontaliere.git-maintenance-$schedule"
      plist="$launch_agents/$label.plist"
      backup="$backup_dir/$label.plist"
      [ -f "$backup" ] || continue
      "$launchctl_bin" bootout "gui/$uid" "$plist" >/dev/null 2>&1 || true
      /bin/cp "$backup" "$plist"
      "$plutil_bin" -lint "$plist" >/dev/null
      "$launchctl_bin" bootstrap "gui/$uid" "$plist"
    done
    /bin/rm -f "$wrapper"
    /bin/mkdir -p "$install_dir"
    : >"$disabled_marker"
    /bin/chmod 600 "$disabled_marker"
    printf 'LaunchAgent Git originali ripristinati.\n'
    ;;
  *)
    printf '%s uso: %s [--restore]\n' "install-git-maintenance-wrapper:" "$0" >&2
    exit 64
    ;;
esac
