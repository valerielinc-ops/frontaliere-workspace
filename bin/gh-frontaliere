#!/usr/bin/env node

import { createInterface } from 'node:readline/promises';

import {
  confirmCancellation,
  eventSubscription,
  eventSummary,
  eventSubscriptions,
  garbageCollectEvents,
  getPendingCancellation,
  listenForEvent,
  reconcileEvents,
  sendRequest,
  subscribeToEvents,
  unsubscribeFromEvents,
  waitForCoordinatorStop,
} from './github-coordinator-client.mjs';

function printStatus(status) {
  process.stdout.write(`${JSON.stringify(status, null, 2)}\n`);
}

function printResponse(response) {
  if (response?.stdout) process.stdout.write(response.stdout);
  if (response?.stderr) process.stderr.write(response.stderr);
  process.exitCode = Number.isInteger(response?.exitCode) ? response.exitCode : (response?.ok ? 0 : 1);
}

function printJson(value) {
  process.stdout.write(`${JSON.stringify(value, null, 2)}\n`);
}

function printHelp(topic = '') {
  const help = topic === 'events'
    ? [
      'Uso: bin/gh-frontaliere events <comando>',
      '',
      'Comandi:',
      '  subscribe  registra un interesse e restituisce scadenza ed ETA storica',
      '  listen     attende l evento in modo event-driven e invia l ack',
      '  show       mostra una subscription',
      '  unsubscribe rimuove una subscription',
      '  status     stato compatto (usa --full solo per il dettaglio completo)',
      '  summary    riepilogo compatto di listener, duplicati, pending ed ETA',
      '  gc         dry-run degli orfani; usa --apply per rimuovere solo candidati sicuri',
      '  reconcile  riconcilia una sola volta tramite il coordinatore',
      '',
      'Regola: dopo subscribe esegui un solo listen sotto il supervisor; non usare polling gh/status.',
    ].join('\n')
    : topic === 'subscribe'
      ? 'Uso: bin/gh-frontaliere events subscribe --repo owner/repo --resource pull_request --wait-for merged,failed [--ttl secondi] [--agent-id id]'
      : topic === 'listen'
        ? 'Uso: bin/gh-frontaliere events listen <subscription-id>\nIl comando resta in ascolto fino all evento o alla scadenza della subscription.'
        : [
          'Uso: bin/gh-frontaliere <comando gh...>',
          '     bin/gh-frontaliere status [--compact|--full]',
          '     bin/gh-frontaliere events <subscribe|listen|show|unsubscribe|status|summary|gc|reconcile>',
          '     bin/gh-frontaliere health [--identity default|nanako] [--alert-only]',
          '     bin/gh-frontaliere confirm-cancel <request-id>',
          '',
          'Le richieste GitHub passano sempre dal coordinatore locale.',
        ].join('\n');
  process.stdout.write(`${help}\n`);
}

function optionValue(args, name) {
  const index = args.findIndex((value) => value === name || value.startsWith(`${name}=`));
  if (index < 0) return null;
  if (args[index].startsWith(`${name}=`)) return args[index].slice(name.length + 1);
  return args[index + 1] || null;
}

function optionValues(args, name) {
  const values = [];
  for (let index = 0; index < args.length; index += 1) {
    if (args[index] === name) {
      if (args[index + 1]) values.push(args[index + 1]);
    } else if (args[index].startsWith(`${name}=`)) {
      values.push(args[index].slice(name.length + 1));
    }
  }
  return values;
}

function assertNoUnknownOptions(args, allowed) {
  const booleanOptions = new Set(['--once', '--keep', '--apply', '--include-unique', '--allow-duplicate', '--shared']);
  for (let index = 0; index < args.length; index += 1) {
    const value = args[index];
    if (!value.startsWith('-')) continue;
    const name = value.includes('=') ? value.slice(0, value.indexOf('=')) : value;
    if (!allowed.has(name)) throw new Error(`opzione events non riconosciuta: ${value}`);
    if (!value.includes('=') && !booleanOptions.has(name)) index += 1;
  }
}

async function runEventsCommand(args, identity) {
  const subcommand = args[1];
  if (args.slice(1).includes('--help') || args.slice(1).includes('-h')) {
    printHelp(subcommand === 'subscribe' || subcommand === 'listen' ? subcommand : 'events');
    return;
  }
  if (!subcommand) {
    printHelp('events');
    return;
  }
  if (subcommand === 'subscribe') {
    const optionArgs = args.slice(2);
    assertNoUnknownOptions(optionArgs, new Set([
      '--repo', '--resource', '--wait-for', '--state', '--number', '--run-id', '--sha',
      '--environment', '--workflow', '--deployment-id', '--ttl', '--agent-id', '--keep', '--once',
      '--allow-duplicate', '--shared',
    ]));
    const repo = optionValue(optionArgs, '--repo');
    const resource = optionValue(optionArgs, '--resource');
    const waitFor = optionValues(optionArgs, '--wait-for').concat(optionValues(optionArgs, '--state'))
      .flatMap((value) => value.split(',')).map((value) => value.trim()).filter(Boolean);
    if (!repo || !resource || waitFor.length === 0) {
      throw new Error(
        'uso: bin/gh-frontaliere events subscribe --repo owner/repo --resource pull_request --wait-for merged,failed',
      );
    }
    const ttlSeconds = optionValue(optionArgs, '--ttl');
    const spec = {
      repo,
      resource,
      waitFor,
      number: optionValue(optionArgs, '--number'),
      runId: optionValue(optionArgs, '--run-id'),
      sha: optionValue(optionArgs, '--sha'),
      environment: optionValue(optionArgs, '--environment'),
      workflow: optionValue(optionArgs, '--workflow'),
      deploymentId: optionValue(optionArgs, '--deployment-id'),
      agentId: optionValue(optionArgs, '--agent-id'),
      once: !optionArgs.includes('--keep'),
      allowDuplicate: optionArgs.includes('--allow-duplicate'),
      shared: optionArgs.includes('--shared'),
    };
    if (ttlSeconds !== null) spec.ttlSeconds = Number(ttlSeconds);
    printJson(await subscribeToEvents(spec, { identity }));
    return;
  }
  if (subcommand === 'listen') {
    const optionArgs = args.slice(3);
    assertNoUnknownOptions(optionArgs, new Set(['--agent-id']));
    if (!args[2] || optionArgs.length > 2) throw new Error('uso: bin/gh-frontaliere events listen <subscription-id> [--agent-id id]');
    printJson(await listenForEvent(args[2], { identity, agentId: optionValue(optionArgs, '--agent-id') }));
    return;
  }
  if (subcommand === 'unsubscribe') {
    if (!args[2] || args.length > 3) throw new Error('uso: bin/gh-frontaliere events unsubscribe <subscription-id>');
    printJson(await unsubscribeFromEvents(args[2], { identity }));
    return;
  }
  if (subcommand === 'show') {
    if (!args[2] || args.length > 3) throw new Error('uso: bin/gh-frontaliere events show <subscription-id>');
    printJson(await eventSubscription(args[2], { identity }));
    return;
  }
  if (subcommand === 'status') {
    const full = args.includes('--full');
    const compact = !full || args.includes('--compact');
    if (args.length > 2 && !((compact || full) && args.length === 3)) {
      throw new Error('uso: bin/gh-frontaliere events status [--compact|--full]');
    }
    printJson(await (compact ? eventSummary({ identity }) : eventSubscriptions({ identity })));
    return;
  }
  if (subcommand === 'summary') {
    if (args.length > 2 && !(args.length === 3 && args[2] === '--compact')) {
      throw new Error('uso: bin/gh-frontaliere events summary');
    }
    printJson(await eventSummary({ identity }));
    return;
  }
  if (subcommand === 'gc') {
    const optionArgs = args.slice(2);
    assertNoUnknownOptions(optionArgs, new Set(['--apply', '--older-than', '--include-unique']));
    const olderThanSeconds = optionValue(optionArgs, '--older-than');
    const olderThanMs = olderThanSeconds === null ? undefined : Number(olderThanSeconds) * 1_000;
    if (olderThanSeconds !== null && (!Number.isFinite(olderThanMs) || olderThanMs <= 0)) {
      throw new Error('uso: bin/gh-frontaliere events gc [--apply] [--older-than secondi] [--include-unique]');
    }
    printJson(await garbageCollectEvents({
      olderThanMs,
      apply: optionArgs.includes('--apply'),
      includeUnique: optionArgs.includes('--include-unique'),
    }, { identity }));
    return;
  }
  if (subcommand === 'reconcile') {
    if (!args[2] || args.length > 3) throw new Error('uso: bin/gh-frontaliere events reconcile <subscription-id>');
    printJson(await reconcileEvents(args[2], { identity }));
    return;
  }
  throw new Error('uso: bin/gh-frontaliere events {subscribe|listen|show|unsubscribe|status|summary|gc|reconcile}');
}

async function confirmCancellationFromOwner(requestId, identity) {
  if (!process.stdin.isTTY || !process.stdout.isTTY) {
    throw new Error(
      'owner_confirmation_requires_interactive_terminal: esegui bin/gh-frontaliere confirm-cancel <request-id> da un terminale del proprietario',
    );
  }

  const response = await getPendingCancellation(requestId, { identity });
  const cancellation = response.cancellation;
  process.stdout.write([
    'Richiesta di cancellazione GitHub in attesa di conferma:',
    `  request_id: ${cancellation.id}`,
    `  target: ${cancellation.target}`,
    `  repo: ${cancellation.repo || '(risolto dal comando gh)'}`,
    `  comando: ${JSON.stringify(cancellation.command)}`,
    `  scadenza: ${cancellation.expiresAt}`,
    '',
  ].join('\n'));

  const readline = createInterface({ input: process.stdin, output: process.stdout });
  let confirmation;
  try {
    confirmation = await readline.question(`Digita "CONFERMA ${requestId}" per autorizzare, o una risposta diversa per annullare: `);
  } finally {
    readline.close();
  }
  const confirmed = await confirmCancellation(requestId, confirmation, { identity });
  printResponse(confirmed);
}

const argv = process.argv.slice(2);
const identityIndex = argv.findIndex((value) => value === '--identity');
const identity = identityIndex >= 0 ? argv[identityIndex + 1] : process.env.FRONTALIERE_GH_IDENTITY;
const args = identityIndex >= 0
  ? argv.slice(0, identityIndex).concat(argv.slice(identityIndex + 2))
  : argv;

try {
  const command = args[0];
  if (command === 'help' || command === undefined || (command === 'status' && args.includes('--help'))) {
    printHelp(command === 'help' && args[1] === 'events' ? 'events' : '');
  } else if (command === 'health') {
    const allowed = new Set(['--alert-only']);
    for (const value of args.slice(1)) {
      if (!allowed.has(value)) throw new Error('uso: bin/gh-frontaliere health [--alert-only]');
    }
    const { checkHealth } = await import('./github-coordinator-health.mjs');
    const result = await checkHealth(identity ? [identity] : undefined);
    if (!args.includes('--alert-only') || !result.ok) printJson(result);
    process.exitCode = result.ok ? 0 : 1;
  } else if (command === 'status' || command === 'ping') {
    const response = await sendRequest({
      type: command === 'status' ? 'status' : 'ping',
      compact: command === 'status' && !args.includes('--full'),
    }, { identity });
    printStatus(response.status || response);
  } else if (command === 'stop') {
    await sendRequest({ type: 'shutdown' }, { identity });
    if (!await waitForCoordinatorStop(identity)) {
      throw new Error('coordinator_shutdown_timeout');
    }
  } else if (command === 'confirm-cancel') {
    if (args.length !== 2 || !args[1]) {
      throw new Error('uso: bin/gh-frontaliere confirm-cancel <request-id>');
    }
    await confirmCancellationFromOwner(args[1], identity);
  } else if (command === 'events') {
    await runEventsCommand(args, identity);
  } else {
    if (args.includes('--watch')) {
      throw new Error('--watch è vietato; usa un solo osservatore condiviso.');
    }
    const response = await sendRequest({ type: 'exec', args, cwd: process.cwd() }, { identity });
    printResponse(response);
  }
} catch (error) {
  if (error?.waitState || error?.nextAction || error?.subscriptionId
    || error?.existingSubscriptionId || error?.targetKey || error?.sharedObserverRecommended) {
    process.stderr.write(`${JSON.stringify({
      ok: false,
      error: {
        code: error.code || 'github_coordinator_error',
        message: error.message,
        subscriptionId: error.subscriptionId,
        waitState: error.waitState,
        nextAction: error.nextAction,
        deadlineAt: error.deadlineAt,
        existingSubscriptionId: error.existingSubscriptionId,
        targetKey: error.targetKey,
        sharedObserverRecommended: error.sharedObserverRecommended,
      },
    })}\n`);
  } else {
    process.stderr.write(`github-coordinator: ${error.message}\n`);
  }
  process.exitCode = Number.isInteger(error.exitCode) ? error.exitCode : 1;
}
