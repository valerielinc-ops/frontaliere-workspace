#!/usr/bin/env node

import { createInterface } from 'node:readline/promises';

import {
  confirmCancellation,
  getPendingCancellation,
  sendRequest,
  waitForCoordinatorStop,
} from './github-coordinator-client.mjs';

function printStatus(status) {
  process.stdout.write(`${JSON.stringify(status, null, 2)}\n`);
}

function printResponse(response) {
  if (response?.stdout) process.stdout.write(response.stdout);
  if (response?.stderr) process.stderr.write(response.stderr);
  process.exitCode = Number.isInteger(response?.exitCode) ? response.exitCode : (response?.ok ? 0 : 1);
}

async function confirmCancellationFromOwner(requestId, identity) {
  if (!process.stdin.isTTY || !process.stdout.isTTY) {
    throw new Error(
      'owner_confirmation_requires_interactive_terminal: esegui bin/gh-frontaliere confirm-cancel <request-id> da un terminale del proprietario',
    );
  }

  const response = await getPendingCancellation(requestId, { identity });
  const cancellation = response.cancellation;
  process.stdout.write([
    'Richiesta di cancellazione GitHub in attesa di conferma:',
    `  request_id: ${cancellation.id}`,
    `  target: ${cancellation.target}`,
    `  repo: ${cancellation.repo || '(risolto dal comando gh)'}`,
    `  comando: ${JSON.stringify(cancellation.command)}`,
    `  scadenza: ${cancellation.expiresAt}`,
    '',
  ].join('\n'));

  const readline = createInterface({ input: process.stdin, output: process.stdout });
  let confirmation;
  try {
    confirmation = await readline.question(`Digita "CONFERMA ${requestId}" per autorizzare, o una risposta diversa per annullare: `);
  } finally {
    readline.close();
  }
  const confirmed = await confirmCancellation(requestId, confirmation, { identity });
  printResponse(confirmed);
}

const argv = process.argv.slice(2);
const identityIndex = argv.findIndex((value) => value === '--identity');
const identity = identityIndex >= 0 ? argv[identityIndex + 1] : process.env.FRONTALIERE_GH_IDENTITY;
const args = identityIndex >= 0
  ? argv.slice(0, identityIndex).concat(argv.slice(identityIndex + 2))
  : argv;

try {
  const command = args[0];
  if (command === 'status' || command === 'ping') {
    const response = await sendRequest({ type: command === 'status' ? 'status' : 'ping' }, { identity });
    printStatus(response.status || response);
  } else if (command === 'stop') {
    await sendRequest({ type: 'shutdown' }, { identity });
    if (!await waitForCoordinatorStop(identity)) {
      throw new Error('coordinator_shutdown_timeout');
    }
  } else if (command === 'confirm-cancel') {
    if (args.length !== 2 || !args[1]) {
      throw new Error('uso: bin/gh-frontaliere confirm-cancel <request-id>');
    }
    await confirmCancellationFromOwner(args[1], identity);
  } else {
    if (args.includes('--watch')) {
      throw new Error('--watch è vietato; usa un solo osservatore condiviso.');
    }
    const response = await sendRequest({ type: 'exec', args, cwd: process.cwd() }, { identity });
    printResponse(response);
  }
} catch (error) {
  process.stderr.write(`github-coordinator: ${error.message}\n`);
  process.exitCode = Number.isInteger(error.exitCode) ? error.exitCode : 1;
}
