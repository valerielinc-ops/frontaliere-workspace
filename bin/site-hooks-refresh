#!/bin/sh
# Mantiene un worktree pulito del sito che segue origin/main, da cui gli hook
# della root eseguono gli script (bin/site-hook).
#
# Perche'. Gli hook lanciavano gli script dal checkout principale del sito,
# che resta su un branch di lavoro anche per giorni: il 2026-09-19 era su un
# branch fermo da 9 giorni con modifiche non committate, e lo Stop hook
# continuava a filtrare le review per `claude[bot]` ore dopo il merge della
# fix (#9272). Una fix mergiata agli hook non arrivava mai alle sessioni.
#
# Il worktree e' detached, sparse (scripts/, package.json e .githooks/: vedi
# sparse_set sotto), condivide node_modules col checkout principale e non si
# modifica a mano: questo script lo ricrea o lo riallinea con fetch + checkout
# --detach, e riporta il set sparse a quello di sparse_set, togliendo anche i
# path aggiunti a mano. Non tocca mai il checkout principale ne' il suo branch.
#
# Uso: bin/site-hooks-refresh [--force]   (throttle 15 min senza --force)
# POSIX sh: gira da /bin/sh negli hook, niente bash-ismi.
set -u

ws="${WORKSPACE:-}"
if [ -z "$ws" ] || [ ! -d "$ws/frontaliere-si-o-no" ]; then
  ws="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)" || exit 0
fi
site="$ws/frontaliere-si-o-no"
[ -d "$site/.git" ] || exit 0
wt="${FRONTALIERE_SITE_HOOKS_DIR:-$site/.claude/worktrees/hooks-main}"
gitdir="$(git -C "$site" rev-parse --git-common-dir 2>/dev/null)" || exit 0
case "$gitdir" in /*) ;; *) gitdir="$site/$gitdir" ;; esac
stamp="$gitdir/hooks-main.stamp"
lock="$gitdir/hooks-main.lock"

if [ "${1:-}" != "--force" ] && [ -f "$stamp" ] && [ -e "$wt/.git" ] \
   && [ -n "$(find "$stamp" -mmin -15 2>/dev/null)" ]; then
  exit 0
fi

# Un solo refresh per volta: piu' sessioni partono insieme.
if ! mkdir "$lock" 2>/dev/null; then
  if [ -n "$(find "$lock" -maxdepth 0 -mmin +10 2>/dev/null)" ]; then
    rmdir "$lock" 2>/dev/null
    mkdir "$lock" 2>/dev/null || exit 0
  else
    exit 0
  fi
fi
trap 'rmdir "$lock" 2>/dev/null' EXIT INT TERM

git -C "$site" fetch -q origin '+refs/heads/main:refs/remotes/origin/main' </dev/null || exit 0

# Set sparse di hooks-main: gli script degli hook e `.githooks/`, perche'
# prune-merged-worktrees spinge gli snapshot da qui con il pre-push di
# origin/main (quello del checkout principale e' indietro di settimane sui Mac
# agenti). Un hooks-main nato col set precedente viene riallineato.
sparse_set() { printf '%s\n' '/scripts/' '/package.json' '/.githooks/'; }

if [ ! -e "$wt/.git" ]; then
  git -C "$site" worktree prune 2>/dev/null
  git -C "$site" worktree add -q --detach --no-checkout "$wt" origin/main || exit 0
  sparse_set | git -C "$wt" sparse-checkout set --no-cone --stdin || exit 0
elif [ "$(git -C "$wt" sparse-checkout list 2>/dev/null)" != "$(sparse_set)" ]; then
  sparse_set | git -C "$wt" sparse-checkout set --no-cone --stdin 2>/dev/null || true
fi

if ! git -C "$wt" checkout -q --detach origin/main 2>/dev/null; then
  # hooks-main non si modifica a mano. Una modifica locale (un agente che ha
  # corretto uno script qui invece che in una PR) bloccava il riallineamento per
  # sempre e gli hook giravano script vecchi: sul Mac principale hooks-main e'
  # rimasto fermo a #19684 dal 21 al 24/11/2026 per un portal.mjs gia' mergiato
  # con #19687. Il diff viene salvato nella gitdir comune, poi il checkout e'
  # forzato.
  patch="$gitdir/hooks-main-dirty-$(date +%Y%m%dT%H%M%S).patch"
  if git -C "$wt" diff HEAD >"$patch" 2>/dev/null && [ -s "$patch" ]; then
    printf 'site-hooks-refresh: hooks-main aveva modifiche locali, salvate in %s\n' "$patch" >&2
  else
    rm -f "$patch"
  fi
  git -C "$wt" checkout -q -f --detach origin/main || exit 0
fi

if [ -d "$site/node_modules" ] && [ ! -e "$wt/node_modules" ]; then
  ln -s "$site/node_modules" "$wt/node_modules"
fi

touch "$stamp"
exit 0
